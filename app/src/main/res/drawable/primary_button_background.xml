<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E43A625D" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#AA9BE9D8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#D52B4F4A"
                android:endColor="#C91C3938" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#7086D9C7" />
        </shape>
    </item>
</selector>
