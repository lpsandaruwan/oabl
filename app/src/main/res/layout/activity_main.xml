<?xml version="1.0" encoding="utf-8"?>
<!-- HomeLayout reuses these cards for energy, navigation and media focus without page scrolling. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0E1217" android:keepScreenOn="true">
  <ImageView android:id="@+id/wallpaper" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="centerCrop" />
  <View android:id="@+id/wallpaper_scrim" android:layout_width="match_parent" android:layout_height="match_parent" />
  <LinearLayout android:id="@+id/home_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="4dp">
    <LinearLayout android:id="@+id/top_bar" android:layout_width="match_parent" android:layout_height="89dp" android:gravity="center_vertical" android:orientation="horizontal">
      <LinearLayout android:id="@+id/clock_card" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical">
        <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:includeFontPadding="false" android:fontFamily="sans-serif-light" android:fontFeatureSettings="tnum" android:letterSpacing="-0.03" android:textSize="75sp" android:textColor="@color/ink" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
          <TextView android:id="@+id/vehicle_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NAMMI 1 · E3" android:textSize="13sp" android:textColor="@color/accent" android:letterSpacing="0.16" android:fontFamily="sans-serif-medium" android:maxLines="1" />
          <TextClock android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="EEEE, d MMMM" android:format24Hour="EEEE, d MMMM" android:textSize="17sp" android:textColor="@color/muted" android:layout_marginTop="4dp" android:maxLines="1" />
          <TextView android:id="@+id/weather_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Weather · tap to set up" android:textSize="12sp" android:textColor="@color/muted" android:clickable="true" android:focusable="true" />
        </LinearLayout>
      </LinearLayout>
      <FrameLayout android:id="@+id/header_space" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:paddingStart="24dp" android:paddingEnd="24dp">
        <LinearLayout android:id="@+id/car_strip" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="center" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:visibility="gone" android:clickable="true" android:focusable="true" android:contentDescription="Car link. Tap for status">
          <TextView android:id="@+id/car_link_note" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="" android:textSize="13sp" android:textColor="@color/muted" android:fontFamily="sans-serif-medium" android:singleLine="true" android:visibility="gone" />
        </LinearLayout>
      </FrameLayout>
      <LinearLayout android:id="@+id/status_block" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical|end" android:paddingStart="12dp">
        <TextView android:id="@+id/network_status" android:layout_width="wrap_content" android:gravity="end" android:layout_height="wrap_content" android:text="Connectivity" android:textSize="15sp" android:textColor="@color/ink" android:maxLines="2" android:ellipsize="end" android:clickable="true" android:focusable="true" android:minHeight="48dp" android:maxWidth="560dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:lineSpacingExtra="4dp" />
        <TextView android:id="@+id/wifi_detail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:textColor="@color/muted" android:visibility="gone" />
        <TextView android:id="@+id/gps_health" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:textColor="@color/muted" android:visibility="gone" />
        <TextView android:id="@+id/device_battery" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:textColor="@color/muted" android:visibility="gone" />
      </LinearLayout>
    </LinearLayout>
    <FrameLayout android:id="@+id/stage" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp">
      <LinearLayout android:id="@+id/dashboard_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:baselineAligned="false">
        <LinearLayout android:id="@+id/main_row" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginTop="0dp" android:orientation="vertical" android:baselineAligned="false" android:layout_marginStart="10dp">
          <LinearLayout android:id="@+id/telemetry_card" android:layout_width="match_parent" android:layout_height="0dp" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="18dp" android:paddingTop="12dp" android:paddingBottom="10dp" android:layout_weight="1.2">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
              <TextView android:id="@+id/telemetry_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="SPEED · GPS" android:textSize="13sp" android:textColor="@color/muted" android:letterSpacing="0.16" android:fontFamily="sans-serif-medium" />
              <TextView android:id="@+id/speed_scale" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0–140" android:textSize="13sp" android:textColor="@color/muted" android:letterSpacing="0.12" android:fontFamily="sans-serif-medium" />
            </LinearLayout>
            <com.softiva.oabl.SpeedGaugeView android:id="@+id/speed_cluster" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical|start" android:orientation="horizontal" android:clickable="true" android:focusable="true">
              <TextView android:id="@+id/speed_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical|start" android:text="—" android:textSize="88sp" android:textColor="@color/ink" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:letterSpacing="-0.04" android:includeFontPadding="false" android:maxLines="1" android:singleLine="true" />
              <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp" android:layout_gravity="bottom" android:layout_marginBottom="14dp">
                <TextView android:id="@+id/speed_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="km/h" android:textSize="15sp" android:textColor="@color/muted" />
                <TextView android:id="@+id/launcher_tagline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:visibility="gone" android:textSize="13sp" android:textColor="@color/muted" android:fontFamily="sans-serif-medium" android:letterSpacing="0.14" android:maxLines="1" />
              </LinearLayout>
              <TextView android:id="@+id/speed_limit" android:layout_width="0dp" android:layout_height="0dp" android:text="" android:visibility="gone" />
            </com.softiva.oabl.SpeedGaugeView>
            <com.softiva.oabl.HeadingStripView android:id="@+id/heading_strip" android:layout_width="match_parent" android:layout_height="0dp" android:visibility="gone" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
              <TextView android:id="@+id/current_road" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Waiting for GPS" android:textSize="12sp" android:textColor="@color/ink" android:maxLines="1" android:ellipsize="end" android:layout_marginEnd="8dp" />
              <LinearLayout android:id="@+id/car_conditions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
                <TextView android:id="@+id/outside_temperature" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OUT —" android:textSize="13sp" android:textColor="@color/ink" android:fontFamily="sans-serif-medium" android:maxLines="1" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MODE" android:textSize="13sp" android:textColor="@color/muted" android:fontFamily="sans-serif-medium" android:layout_marginStart="12dp" android:layout_marginEnd="4dp" />
                <TextView android:id="@+id/drive_mode_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="12sp" android:textColor="@color/accent" android:fontFamily="sans-serif-medium" android:maxLines="1" android:gravity="center_vertical" />
              </LinearLayout>
            </LinearLayout>
          </LinearLayout>
          <LinearLayout android:id="@+id/navigation_hint_card" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.1" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:clickable="true" android:focusable="true" android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
              <TextView android:id="@+id/navigation_hint_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="NAVIGATION" android:textSize="13sp" android:textColor="@color/muted" android:letterSpacing="0.16" android:fontFamily="sans-serif-medium" />
            </LinearLayout>
            <LinearLayout android:id="@+id/navigation_idle" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
              <TextView android:id="@+id/navigation_where" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Waiting for GPS" android:textSize="24sp" android:textColor="@color/ink" android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end" android:lineSpacingMultiplier="1.05" />
              <com.softiva.oabl.DriveStatsView android:id="@+id/navigation_stats" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="16dp" android:layout_marginBottom="14dp" android:visibility="gone" />
              <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:scrollbars="none" android:overScrollMode="never" android:fadingEdgeLength="24dp" android:requiresFadingEdge="horizontal" android:fillViewport="true">
                <LinearLayout android:id="@+id/navigation_chips" android:layout_width="wrap_content" android:layout_height="48dp" android:orientation="horizontal" />
              </HorizontalScrollView>
              <HorizontalScrollView android:id="@+id/navigation_chips_2_host" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:scrollbars="none" android:overScrollMode="never" android:fillViewport="true" android:visibility="gone">
                <LinearLayout android:id="@+id/navigation_chips_2" android:layout_width="wrap_content" android:layout_height="48dp" android:orientation="horizontal" />
              </HorizontalScrollView>
              <LinearLayout android:id="@+id/navigation_recents" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/navigation_guidance" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:visibility="gone">
              <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
              <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/navigation_hint_icon" android:layout_width="44dp" android:layout_height="44dp" android:contentDescription="@null" android:scaleType="fitCenter" android:padding="4dp" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="14dp">
                  <TextView android:id="@+id/navigation_hint_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="24sp" android:textColor="@color/ink" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
                  <LinearLayout android:id="@+id/navigation_eta_block" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/navigation_eta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="16sp" android:textColor="@color/ink" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="ETA" android:textSize="13sp" android:textColor="@color/muted" android:fontFamily="sans-serif-medium" android:letterSpacing="0.14" />
                  </LinearLayout>
                </LinearLayout>
              </LinearLayout>
                <TextView android:id="@+id/navigation_hint_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:textColor="@color/ink" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="12dp" />
                <TextView android:id="@+id/navigation_hint_trip" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:textColor="@color/muted" android:layout_marginTop="6dp" android:fontFeatureSettings="tnum" android:maxLines="1" android:ellipsize="end" />
              </LinearLayout>
              <com.softiva.oabl.TurnProgressView android:id="@+id/navigation_turn_progress" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp" android:layout_marginEnd="4dp" />
              <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                <TextView android:id="@+id/navigation_arrival_soc" android:layout_width="wrap_content" android:layout_height="36dp" android:text="" android:textSize="13sp" android:textColor="@color/accent" android:fontFamily="sans-serif-medium" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:maxLines="1" android:visibility="gone" android:clickable="true" android:focusable="true" android:contentDescription="Estimated battery on arrival" />
                <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp" />
                <TextView android:id="@+id/navigation_end" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="12dp" android:text="End" android:textSize="14sp" android:textColor="@color/ink" android:fontFamily="sans-serif-medium" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:visibility="gone" android:clickable="true" android:focusable="true" android:contentDescription="End navigation" />
              </LinearLayout>
            </LinearLayout>
          </LinearLayout>
          <LinearLayout android:id="@+id/calendar_column" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.1" android:orientation="horizontal" android:layout_marginTop="10dp">
            <LinearLayout android:id="@+id/calendar_card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginTop="0dp" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="8dp" android:clickable="true" android:focusable="true" android:layout_weight=".85" android:layout_marginEnd="10dp">
              <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/weather_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="WEATHER" android:textSize="13sp" android:textColor="@color/muted" android:letterSpacing="0.16" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/weather_updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:textColor="@color/muted" android:visibility="gone" />
              </LinearLayout>
              <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
                <FrameLayout android:id="@+id/weather_icon_host" android:layout_width="28dp" android:layout_height="28dp" />
                <TextView android:id="@+id/weather_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textSize="30sp" android:textColor="@color/ink" android:fontFamily="sans-serif-light" android:fontFeatureSettings="tnum" android:includeFontPadding="false" android:layout_marginStart="4dp" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp">
                  <TextView android:id="@+id/weather_condition" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="@color/ink" android:maxLines="2" android:ellipsize="end" />
                  <TextView android:id="@+id/weather_range" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:textColor="@color/muted" android:fontFeatureSettings="tnum" android:maxLines="2" android:ellipsize="end" />
                </LinearLayout>
                <TextView android:id="@+id/weather_sun" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="@color/muted" android:fontFeatureSettings="tnum" android:gravity="end" android:maxLines="2" android:visibility="gone" />
              </LinearLayout>
              <LinearLayout android:id="@+id/weather_hours" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:layout_marginTop="4dp" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/right_column" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.25" android:orientation="vertical" android:layout_marginEnd="0dp">
              <FrameLayout android:id="@+id/media_card" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="true" android:focusable="true">
                <LinearLayout android:id="@+id/media_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="6dp">
                  <LinearLayout android:id="@+id/media_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/media_section_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="NOW PLAYING" android:textSize="13sp" android:textColor="@color/muted" android:letterSpacing=".08" android:fontFamily="sans-serif-medium" />
                    <TextView android:id="@+id/media_format" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:text="" android:textSize="13sp" android:textColor="@color/muted" android:letterSpacing="0.08" android:fontFamily="sans-serif-medium" android:singleLine="true" android:visibility="gone" />
                    <TextView android:id="@+id/media_source" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:textColor="@color/muted" android:fontFamily="sans-serif-medium" android:drawablePadding="6dp" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:maxWidth="76dp" />
                  </LinearLayout>
                  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/media_info_row">
                    <ImageView android:id="@+id/media_artwork" android:layout_width="34dp" android:layout_height="36dp" android:contentDescription="@string/open_player" android:scaleType="fitCenter" android:padding="0dp" />
                    <LinearLayout android:id="@+id/media_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
                      <TextView android:id="@+id/media_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nothing_playing" android:textSize="16sp" android:textColor="@color/ink" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:letterSpacing="-0.01" />
                      <TextView android:id="@+id/media_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/media_hint" android:textSize="12sp" android:textColor="@color/muted" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" />
                    </LinearLayout>
                  </LinearLayout>
                  <com.softiva.oabl.MediaProgressView android:id="@+id/media_progress" android:layout_width="match_parent" android:layout_height="0dp" android:visibility="gone" />
                  <LinearLayout android:id="@+id/media_controls" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical|center_horizontal">
                    <ImageView android:id="@+id/media_previous" android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:src="@drawable/ic_media_prev" android:scaleType="fitCenter" android:clickable="true" android:focusable="true" android:contentDescription="@string/previous" android:layout_marginStart="0dp" android:layout_marginEnd="0dp" />
                    <ImageView android:id="@+id/media_play_pause" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="0dp" android:layout_marginEnd="0dp" android:padding="13dp" android:src="@drawable/ic_media_play" android:scaleType="fitCenter" android:clickable="true" android:focusable="true" android:contentDescription="@string/play_pause" />
                    <ImageView android:id="@+id/media_next" android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:src="@drawable/ic_media_next" android:scaleType="fitCenter" android:clickable="true" android:focusable="true" android:contentDescription="@string/next" android:layout_marginStart="0dp" android:layout_marginEnd="0dp" />
                    <ImageView android:id="@+id/media_playlists" android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:src="@drawable/ic_music_queue" android:scaleType="fitCenter" android:clickable="true" android:focusable="true" android:contentDescription="Play a playlist" android:layout_marginStart="0dp" android:layout_marginEnd="0dp" />
                    <ImageView android:id="@+id/media_favorite" android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:src="@drawable/ic_music_star" android:scaleType="fitCenter" android:clickable="true" android:focusable="true" android:contentDescription="Favourite this song" android:layout_marginStart="0dp" android:layout_marginEnd="0dp"  android:visibility="gone" />
                    <ImageView android:id="@+id/media_eq" android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:src="@drawable/ic_bar_eq" android:scaleType="fitCenter" android:clickable="true" android:focusable="true" android:contentDescription="Equalizer" android:layout_marginStart="0dp" android:layout_marginEnd="0dp"  android:visibility="gone" />
                    <ImageView android:id="@+id/media_expand" android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:src="@drawable/ic_expand" android:scaleType="fitCenter" android:clickable="true" android:focusable="true" android:contentDescription="Use large player" android:layout_marginStart="0dp" android:layout_marginEnd="0dp" />
                    <View android:id="@+id/media_controls_spacer" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:visibility="gone" />
                    <TextView android:id="@+id/media_open" android:text="Open ↗" android:textSize="15sp" android:textColor="@color/ink" android:fontFamily="sans-serif-medium" android:layout_width="wrap_content" android:minWidth="96dp" android:layout_height="52dp" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:contentDescription="@string/open_player" android:visibility="gone" />
                  </LinearLayout>
                </LinearLayout>
              </FrameLayout>
              <View android:id="@+id/navigation_divider" android:layout_width="1dp" android:layout_height="0dp" android:visibility="gone" />
            </LinearLayout>
          </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/instrument_strip" android:layout_width="0dp" android:layout_height="match_parent" android:orientation="vertical" android:baselineAligned="false" android:layout_weight="1.55">
          <LinearLayout android:id="@+id/energy_card" android:layout_width="match_parent" android:layout_height="0dp" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="16dp" android:paddingBottom="14dp" android:layout_marginEnd="0dp" android:clickable="true" android:focusable="true" android:layout_weight="1.2">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
